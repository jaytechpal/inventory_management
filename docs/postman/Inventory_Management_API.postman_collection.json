							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "User ID"
								}
							]
						},
						"description": "Update an existing user's information.\n\n**Authentication:** Required (Bearer Token)\n\n**URL Parameters:**\n- id (required, integer): User ID\n\n**Optional Fields (all):**\n- name (string, max: 255)\n- email (email, unique)\n- password (string, min: 8)\n- phone (string, max: 20)\n- is_active (boolean)\n- role_ids (array) - Array of role IDs\n\n**Response:** Returns updated user object with roles."
					},
					"response": []
				},
				{
					"name": "Update User (PATCH)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
