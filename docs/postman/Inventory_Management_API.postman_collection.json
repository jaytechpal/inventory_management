{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-a1b2-c3d4e5f67890",
		"name": "Inventory Management API",
		"description": "REST API for Inventory Management System with role-based authentication.\n\n## Features\n- Laravel 13 Backend\n- Laravel Sanctum Authentication\n- Role-Based Access Control\n- MySQL 8.4 Database\n- Redis Caching\n\n## Test Users\nAll users have password: `password`\n\n- admin@inventory.com - Admin\n- manager@inventory.com - Manager\n- storekeeper@inventory.com - Store Keeper\n- sales@inventory.com - Sales Staff\n- accountant@inventory.com - Accountant\n- auditor@inventory.com - Read-only Auditor",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "12345678"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.environment.set(\"auth_token\", jsonData.data.access_token);",
									"        console.log(\"Token saved: \" + jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"phone\": \"+1234567890\",\n    \"role_ids\": [3]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"register"
							]
						},
						"description": "Register a new user account.\n\n**Required Fields:**\n- name (string, max: 255)\n- email (email, unique)\n- password (string, min: 8)\n- password_confirmation (string)\n\n**Optional Fields:**\n- phone (string, max: 20)\n- role_ids (array of role IDs)\n\n**Response:** Returns user object and access token."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.access_token) {",
									"        pm.environment.set(\"auth_token\", jsonData.data.access_token);",
									"        console.log(\"Token saved: \" + jsonData.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@inventory.com\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Authenticate user and receive access token.\n\n**Required Fields:**\n- email (email)\n- password (string)\n\n**Test Credentials:**\n- admin@inventory.com / password\n- manager@inventory.com / password\n- storekeeper@inventory.com / password\n\n**Response:** Returns user object with roles and Bearer token.\n\n**Note:** The token is automatically saved to environment variable `auth_token`."
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"logout"
							]
						},
						"description": "Logout user and revoke current access token.\n\n**Authentication:** Required (Bearer Token)\n\n**Response:** Success message confirming logout."
					},
					"response": []
				},
				{
					"name": "Get Current User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"me"
							]
						},
						"description": "Get authenticated user's information including roles.\n\n**Authentication:** Required (Bearer Token)\n\n**Response:** Returns complete user profile with roles."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for user registration, login, logout, and profile retrieval."
		},
		{
			"name": "User Management",
			"item": [
				{
					"name": "List Users",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users?per_page=15&search=&is_active=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							],
							"query": [
								{
									"key": "per_page",
									"value": "15",
									"description": "Number of users per page (default: 15)"
								},
								{
									"key": "search",
									"value": "",
									"description": "Search by name or email"
								},
								{
									"key": "is_active",
									"value": "",
									"description": "Filter by active status (true/false)"
								}
							]
						},
						"description": "Retrieve paginated list of users with optional filtering.\n\n**Authentication:** Required (Bearer Token)\n\n**Query Parameters:**\n- per_page (optional, integer): Results per page\n- search (optional, string): Search by name or email\n- is_active (optional, boolean): Filter active/inactive users\n\n**Response:** Returns paginated user list with metadata."
					},
					"response": []
				},
				{
					"name": "Create User",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"New User\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\",\n    \"phone\": \"+1234567890\",\n    \"is_active\": true,\n    \"role_ids\": [3]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users"
							]
						},
						"description": "Create a new user (Admin only).\n\n**Authentication:** Required (Bearer Token)\n\n**Required Fields:**\n- name (string, max: 255)\n- email (email, unique)\n- password (string, min: 8)\n- role_ids (array, min: 1) - Array of role IDs\n\n**Optional Fields:**\n- phone (string, max: 20)\n- is_active (boolean, default: true)\n\n**Available Role IDs:**\n- 1: Admin\n- 2: Manager\n- 3: Store Keeper\n- 4: Sales Staff\n- 5: Accountant\n- 6: Read-only Auditor\n\n**Response:** Returns created user object with roles."
					},
					"response": []
				},
				{
					"name": "Get User Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{auth_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/:id",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								":id"
							],
							"variable": [
								{
									"key": "id",
									"value": "1",
									"description": "User ID"
								}
							]
						},
						"description": "Get details of a specific user.\n\n**Authentication:** Required (Bearer Token)\n\n**URL Parameters:**\n- id (required, integer): User ID\n\n**Response:** Returns complete user object with roles."
					},
					"response": []
				},
				{
